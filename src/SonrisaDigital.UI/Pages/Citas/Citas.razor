@page "/cita"
@attribute [Authorize(Policy = "Citas.Ver")]
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Services.Citas
@using SonrisaDigital.Services.Citas.DTOs
@inject ICitaService CitaService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Citas · Sonrisa Digital</PageTitle>

<div class="appointments-page">
    <div class="page-header">
        <div>
            <h1>Citas 📅</h1>
            <p>Administra las citas de los pacientes con los odontólogos.</p>
        </div>
        @if (PuedeCrear)
        {
            <a class="primary-action" href="/cita/nuevo">+ Agendar cita</a>
        }
    </div>

    <section class="filter-panel" aria-label="Filtros de citas">
        <div class="search-field">
            <label for="cita-date">Fecha</label>
            <input id="cita-date" type="date" @bind="selectedDate" @bind:event="oninput" />
        </div>
        <div class="status-field">
            <label for="cita-status">Estado</label>
            <select id="cita-status" @bind="statusFilter">
                <option value="">Todos</option>
                <option value="Programada">Programada</option>
                <option value="Confirmada">Confirmada</option>
                <option value="Atendida">Atendida</option>
                <option value="Cancelada">Cancelada</option>
                <option value="NoAsistio">No asistió</option>
            </select>
        </div>
        <div style="display: flex; gap: 8px; align-items: flex-end;">
            <button class="secondary-action" @onclick="BuscarCitasAsync">Buscar</button>
            <button class="secondary-action" style="background-color: transparent; border: 1px solid transparent; color: #64748b; text-decoration: underline;" @onclick="ClearFilters">Ver todas</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="feedback error" role="alert">@errorMessage</div>
    }

    <section class="table-panel">
        <div class="table-summary">@citas.Total cita(s) encontrada(s)</div>
        @if (loading)
        {
            <div class="table-state">Cargando citas...</div>
        }
        else if (citas.Items.Count == 0)
        {
            <div class="table-state empty-state">
                <strong>No hay citas para mostrar</strong>
                <span>Prueba con otros filtros o agenda una nueva cita.</span>
            </div>
        }
        else
        {
            <div class="activity-scroll" style="max-height: 600px; overflow-y: auto;">
                <table class="appointments-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Paciente</th>
                            <th>Odontólogo</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in citas.Items)
                        {
                            <tr>
                                <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@cita.HoraInicio.ToString("HH:mm") - @cita.HoraFin.ToString("HH:mm")</td>
                                <td><a class="appointment-name" href="/cita/@cita.Id">@cita.PacienteNombre</a></td>
                                <td>@cita.OdontologoNombre</td>
                                <td>@(cita.Motivo ?? "-")</td>
                                <td><span class="status-badge @GetEstadoClass(cita.Estado)">@CitaStateMachine.NombreEstado(cita.Estado)</span></td>
                                <td class="row-actions">
                                    <a href="/cita/@cita.Id">Ver</a>
                                    @if (PuedeEditarCita(cita.Estado))
                                    {
                                        <a href="/cita/editar/@cita.Id">Editar</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!loading && citas.Total > 0)
        {
            <PaginationFooter Page="citas.Page"
                              TotalPages="citas.TotalPages"
                              Total="citas.Total"
                              ItemLabel="cita(s) encontrada(s)"
                              OnPageChange="IrAPaginaCitasAsync" />
        }
    </section>
</div>

@code {
    private const int PageSize = 10;
    private PagedResult<CitaListItemDto> citas = PagedResult<CitaListItemDto>.Empty(PageSize);
    private bool loading;
    private string? errorMessage;
    private string statusFilter = "";
    private ClaimsPrincipal currentUser = new();
    private readonly SemaphoreSlim cargaLock = new(1, 1);

    // EL CAMBIO PRINCIPAL: Se inicializa con la fecha actual
    private DateOnly? selectedDate = DateOnly.FromDateTime(DateTime.Now);

    private bool PuedeCrear => TienePermiso("Citas.Crear");
    private bool PuedeEditar => TienePermiso("Citas.Editar");

    private bool TienePermiso(string permiso) =>
        currentUser.HasClaim(PermissionCatalog.ClaimType, permiso);

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authenticationState.User;

        await LoadCitasAsync();
    }

    private async Task LoadCitasAsync()
    {
        // El DbContext es compartido: se atienden las cargas una por una para que
        // dos clics rápidos no ejecuten consultas al mismo tiempo.
        await cargaLock.WaitAsync();
        loading = true;
        errorMessage = null;
        try
        {
            EstadoCita? estado = statusFilter switch
            {
                "Programada" => EstadoCita.Programada,
                "Confirmada" => EstadoCita.Confirmada,
                "Atendida" => EstadoCita.Atendida,
                "Cancelada" => EstadoCita.Cancelada,
                "NoAsistio" => EstadoCita.NoAsistio,
                _ => null
            };

            // El servicio cuenta en SQL y devuelve solo la página solicitada.
            citas = await CitaService.SearchPagedAsync(selectedDate, null, null, estado, citas.Page, PageSize);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            loading = false;
            cargaLock.Release();
        }
    }

    // Al aplicar un filtro se vuelve a la primera página.
    private async Task BuscarCitasAsync()
    {
        citas = citas with { Page = 1 };
        await LoadCitasAsync();
    }

    private async Task IrAPaginaCitasAsync(int page)
    {
        if (page < 1 || page > citas.TotalPages)
        {
            return;
        }

        citas = citas with { Page = page };
        await LoadCitasAsync();
    }

    // Limpia los filtros y carga el listado completo desde la primera página.
    private async Task ClearFilters()
    {
        selectedDate = null;
        statusFilter = "";
        citas = citas with { Page = 1 };
        await LoadCitasAsync();
    }

    private bool EsRecepcionista => currentUser.IsInRole(RolesSonrisaDigital.Recepcionista);

    // El recepcionista deja de poder editar la cita una vez confirmada.
    private bool PuedeEditarCita(EstadoCita estado) =>
        PuedeEditar && !CitaStateMachine.EsEstadoFinal(estado) &&
        !(estado == EstadoCita.Confirmada && EsRecepcionista);

    private string GetEstadoClass(EstadoCita estado) => estado switch
    {
        EstadoCita.Programada => "programada",
        EstadoCita.Confirmada => "confirmada",
        EstadoCita.Atendida => "atendida",
        EstadoCita.Cancelada => "cancelada",
        EstadoCita.NoAsistio => "no-asistio",
        _ => ""
    };
}