@page "/"
@attribute [Authorize]
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Services.Citas
@using SonrisaDigital.Services.Citas.DTOs
@using SonrisaDigital.Services.Dashboard
@using SonrisaDigital.Services.Dashboard.DTOs
@using SonrisaDigital.Services.Autorizacion
@using SonrisaDigital.Services.Pagos
@using SonrisaDigital.Services.Pagos.DTOs
@using System.Globalization
@inject ICitaService CitaService
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

@* ============================================================================
   PÁGINA: Inicio (Dashboard)        Ruta: /

   ¿Qué hace esta pantalla?
     Es el panel de bienvenida: resume en tarjetas lo que está pasando hoy (citas con sus
     contadores, pacientes activos, odontólogos activos), muestra el saldo pendiente de
     pagos, las próximas citas de la semana y los cobros del mes. También ofrece accesos
     rápidos a las acciones más usadas según los permisos del usuario.

   ¿Cómo se lee este archivo?
     - Markup: accesos rápidos, tarjetas de métricas, tabla de citas de hoy,
       próximas citas, cobros del mes y la tarjeta "Pagos pendientes".
     - @code (al final):
         OnInitializedAsync     -> al abrir la página, cargar todo
         LoadDashboardDataAsync -> 4 bloques: citas, métricas, próximas citas y cobros
         Ayudantes              -> dinero, plurales, colores y símbolos de las etiquetas
   ============================================================================ *@

<PageTitle>Inicio · Sonrisa Digital</PageTitle>

<div class="dashboard-page">
    <div class="page-heading">
        <div>
            <h1>Inicio</h1>
            <p>@RelojNegocio.Ahora().ToString("dddd, d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-DO"))</p>
        </div>

        @* --- ACCESOS RÁPIDOS (cada botón aparece solo con su permiso) --- *@
        <div class="quick-actions">
            <AuthorizeView Policy="Pacientes.Crear">
                <Authorized>
                    <a class="quick-action" href="/pacientes/nuevo" title="Registrar un paciente nuevo">
                        <span aria-hidden="true">+</span> Paciente
                    </a>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Policy="Citas.Crear">
                <Authorized>
                    <a class="quick-action" href="/cita/nuevo" title="Agendar una cita nueva">
                        <span aria-hidden="true">+</span> Cita
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    @* --- TARJETAS DE ESTADÍSTICAS --- *@
    <div class="stats-grid">
        @* La tarjeta de citas solo se muestra a quien puede consultar citas. *@
        <AuthorizeView Policy="Citas.Ver">
            <Authorized>
                <div class="stat-card">
                    <span>Citas hoy</span>
                    <strong>@totalCitasHoy</strong>
                    <small>@citasProgramadas pendientes de confirmar</small>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="stat-card">
            <span>Pacientes activos</span>
            <strong>@pacientesActivos.ToString("N0")</strong>
            <small class="positive">+@pacientesNuevosSemana esta semana</small>
        </div>

        <div class="stat-card">
            <span>Odontólogos activos</span>
            <strong>@odontologosActivos.ToString("N0")</strong>
            <small>Disponibles en clínica</small>
        </div>

        @* Visible para todos los usuarios de la clínica. El detalle de pagos sigue en el módulo Pagos. *@
        <div class="stat-card">
            <span>Pagos pendientes</span>
            <strong>@Money(resumen.SaldoPendiente)</strong>
            @if (resumen.TratamientosConSaldo > 0)
            {
                <small class="negative">@FormatTratamientos(resumen.TratamientosConSaldo)</small>
            }
            else
            {
                <small class="positive">Sin saldos pendientes</small>
            }
        </div>
    </div>

    @* --- CUADRÍCULA PRINCIPAL DEL PANEL --- *@
    @* Las citas y su resumen solo se muestran a quien tiene permiso de consultarlas. *@
    <AuthorizeView Policy="Citas.Ver">
        <Authorized>
            <div class="dashboard-grid">
                @* Citas del Día *@
                <section class="dashboard-panel appointments-panel">
                    <div class="panel-heading">
                        <h2>Citas de hoy</h2>
                        <a href="/cita">Ver todas</a>
                    </div>

                    <div class="table-scroll" style="max-height: 250px; overflow-y: auto;">
                        @if (loading)
                        {
                            <div style="padding: 20px; text-align: center;">Cargando citas de hoy...</div>
                        }
                        else if (!citasHoy.Any())
                        {
                            <div style="padding: 20px; text-align: center; color: #64748b;">No hay citas agendadas para el día de hoy.</div>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                    <tr>
                                        <th>Hora</th>
                                        <th>Paciente</th>
                                        <th>Odontólogo</th>
                                        <th>Motivo</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in citasHoy)
                                    {
                                        <tr>
                                            <td class="mono">@cita.HoraInicio.ToString("HH:mm")</td>
                                            <td><strong>@cita.PacienteNombre</strong></td>
                                            <td>@cita.OdontologoNombre</td>
                                            <td>@(cita.Motivo ?? "-")</td>
                                            <td>
                                                <span class="status @GetEstadoClassDashboard(cita.Estado)">
                                                    @GetEstadoTextoDashboard(cita.Estado)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>

                @* Resumen del Día *@
                <section class="dashboard-panel day-summary">
                    <div class="panel-heading">
                        <h2>Resumen del día</h2>
                    </div>

                    <div class="summary-list">
                        <div>
                        </div>
                        <div>
                            <span><i class="dot blue"></i>Programadas</span>
                            <strong>@citasProgramadas</strong>
                        </div>
                        <div>
                            <span><i class="dot green"></i>Confirmadas</span>
                            <strong>@citasConfirmadas</strong>
                        </div>
                        <div>
                            <span><i class="dot fuchsia"></i>Atendidas hoy</span>
                            <strong>@citasAtendidas</strong>
                        </div>
                        <div>
                            <span><i class="dot red"></i>Canceladas hoy</span>
                            <strong>@citasCanceladas</strong>
                        </div>
                        <div>
                            <span><i class="dot gray"></i>No asistio</span>
                            <strong>@citasNoAsistio</strong>
                        </div>
                        <div>
                        </div>
                    </div>

                    <div class="summary-total">
                        <span>Total citas hoy</span>
                        <strong>@totalCitasHoy</strong>
                    </div>
                </section>
            </div>
        </Authorized>
    </AuthorizeView>

    @* --- PRÓXIMAS CITAS Y COBROS DEL MES --- *@
    @* Cada panel aparece solo si el usuario tiene el permiso correspondiente. *@
    @if (puedeVerCitas || puedeVerPagos)
    {
        <div class="dashboard-grid @(puedeVerCitas && puedeVerPagos ? "" : "is-single")">
            @if (puedeVerCitas)
            {
                <section class="dashboard-panel upcoming-panel">
                    <div class="panel-heading">
                        <h2>Próximas citas · 7 días</h2>
                        <a href="/cita">Ver agenda</a>
                    </div>

                    <div class="table-scroll" style="max-height: 250px; overflow-y: auto;">
                        @if (loading)
                        {
                            <div class="panel-placeholder">Cargando próximas citas...</div>
                        }
                        else if (proximasCitas.Count == 0)
                        {
                            <div class="panel-placeholder">No hay citas en los próximos 7 días.</div>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead style="position: sticky; top: 0; background-color: #ffffff; z-index: 2;">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Hora</th>
                                        <th>Paciente</th>
                                        <th>Odontólogo</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cita in proximasCitas)
                                    {
                                        <tr>
                                            <td class="mono">@cita.Fecha.ToString("ddd dd/MM", Cultura)</td>
                                            <td class="mono">@cita.HoraInicio.ToString("HH:mm")</td>
                                            <td><strong>@cita.PacienteNombre</strong></td>
                                            <td>@cita.OdontologoNombre</td>
                                            <td>
                                                <span class="status @GetEstadoClassDashboard(cita.Estado)">
                                                    @GetEstadoTextoDashboard(cita.Estado)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>
            }

            @if (puedeVerPagos)
            {
                <section class="dashboard-panel collections-panel">
                    <div class="panel-heading">
                        <h2>Cobros del mes</h2>
                        <a href="/reportes">Ver reportes</a>
                    </div>

                    <div class="collections-body">
                        @if (loading || cobros is null)
                        {
                            <div class="panel-placeholder">@(loading ? "Cargando cobros..." : "No se pudieron cargar los cobros.")</div>
                        }
                        else
                        {
                            <div class="collection-item">
                                <span>Cobrado hoy</span>
                                <strong>@Money(cobros.CobradoHoy)</strong>
                            </div>
                            <div class="collection-item primary">
                                <span>Cobrado este mes</span>
                                <strong>@Money(cobros.CobradoMes)</strong>
                            </div>
                            <div class="collection-item">
                                <span>Pagos registrados</span>
                                <strong>@cobros.PagosMes.ToString("N0")</strong>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    // Cultura de República Dominicana: se usa para escribir el dinero como "RD$ 12,500".
    private static readonly CultureInfo Cultura = new("es-DO");

    // ===== Datos que se pintan en la pantalla =====
    private List<CitaListItemDto> citasHoy = [];                    // citas de hoy, ordenadas por hora
    private List<CitaListItemDto> proximasCitas = [];               // agenda de los próximos 7 días
    private PagosResumenDto resumen = new(0, 0, 0, 0);              // números de la tarjeta "Pagos pendientes"
    private DashboardCobrosDto? cobros;                             // cobros de hoy y de lo que va del mes
    private bool loading = true;                                    // ¿la página sigue cargando?
    private bool puedeVerCitas;                                     // evita consultar las citas sin permiso
    private bool puedeVerPagos;                                     // evita consultar los cobros sin permiso

    // ===== Contadores (métricas) que se calculan al cargar =====
    private int totalCitasHoy = 0;
    private int citasProgramadas = 0;
    private int citasConfirmadas = 0;
    private int citasAtendidas = 0;
    private int citasCanceladas = 0;
    private int citasNoAsistio = 0;
    private int pacientesActivos = 0;
    private int pacientesNuevosSemana = 0;
    private int odontologosActivos = 0;

    protected override async Task OnInitializedAsync()
    {
        // Al abrir la página se carga todo de una sola vez.
        await LoadDashboardDataAsync();
    }

    /// <summary>
    /// Carga todo lo que muestra el panel de inicio: las citas de hoy con sus contadores,
    /// las próximas citas de la semana, los pacientes y odontólogos activos, el saldo
    /// pendiente y los cobros del mes (los mismos números reales del módulo de Pagos).
    /// </summary>
    private async Task LoadDashboardDataAsync()
    {
        loading = true;
        try
        {
            // Los permisos se comprueban antes de consultar. Los paneles también están
            // dentro de AuthorizeView, pero así evitamos ejecutar consultas que el
            // usuario no puede usar y que antes terminaban en una excepción silenciosa.
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = authenticationState.User;

            puedeVerCitas = usuario.HasClaim(PermissionCatalog.ClaimType, "Citas.Ver");
            puedeVerPagos = usuario.HasClaim(PermissionCatalog.ClaimType, "Pagos.Ver");

            DateOnly hoy = RelojNegocio.HoyDateOnly();

            // 1. CITAS DE HOY
            if (puedeVerCitas)
            {
                var resultCitas = await CitaService.SearchAsync(hoy, null, null, null);
                citasHoy = resultCitas.OrderBy(c => c.HoraInicio).ToList();

                totalCitasHoy = citasHoy.Count;
                citasProgramadas = citasHoy.Count(c => c.Estado == EstadoCita.Programada);
                citasConfirmadas = citasHoy.Count(c => c.Estado == EstadoCita.Confirmada);
                citasAtendidas = citasHoy.Count(c => c.Estado == EstadoCita.Atendida);
                citasCanceladas = citasHoy.Count(c => c.Estado == EstadoCita.Cancelada);
                citasNoAsistio = citasHoy.Count(c => c.Estado == EstadoCita.NoAsistio);

                // 2. PRÓXIMAS CITAS (desde mañana hasta dentro de 7 días)
                // Se excluyen las canceladas: no forman parte de la agenda por atender.
                proximasCitas = (await CitaService.SearchRangoAsync(hoy.AddDays(1), hoy.AddDays(7)))
                    .Where(c => c.Estado != EstadoCita.Cancelada)
                    .ToList();
            }

            // 3. MÉTRICAS DE PACIENTES Y ODONTÓLOGOS (solo con permiso de lectura de ambos)
            // El servicio hace los conteos en SQL; la pantalla ya no carga las listas completas.
            if (usuario.HasClaim(PermissionCatalog.ClaimType, "Pacientes.Ver")
                && usuario.HasClaim(PermissionCatalog.ClaimType, "Odontologos.Ver"))
            {
                var stats = await DashboardService.GetStatsAsync();
                pacientesActivos = stats.TotalPacientesActivos;
                odontologosActivos = stats.TotalOdontologosActivos;
                pacientesNuevosSemana = stats.PacientesRegistradosEstaSemana;
            }

            // 4. SALDO PENDIENTE (misma fuente que el módulo de Pagos, sin datos ficticios)
            resumen = await DashboardService.GetResumenPagosAsync();

            // 5. COBROS DEL MES (solo con permiso de lectura de pagos)
            if (puedeVerPagos)
            {
                cobros = await DashboardService.GetCobrosMesAsync();
            }
        }
        catch (Exception)
        {
            // Captura de errores silenciosa para no tumbar la interfaz
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Da formato de dinero en pesos dominicanos sin decimales: 12500 → "RD$12,500".
    /// Se usa en la tarjeta "Pagos pendientes".
    /// </summary>
    private static string Money(decimal value) => $"RD${value.ToString("N0", Cultura)}";

    /// <summary>
    /// Escribe la cantidad de tratamientos en singular o plural: "1 tratamiento" / "3 tratamientos".
    /// Es el texto pequeño que aparece debajo del saldo pendiente.
    /// </summary>
    private static string FormatTratamientos(int cantidad) =>
        cantidad == 1 ? "1 tratamiento" : $"{cantidad} tratamientos";

    private string GetEstadoClassDashboard(EstadoCita estado) => estado switch
    {
        EstadoCita.Programada => "scheduled",
        EstadoCita.Confirmada => "confirmed",
        EstadoCita.Atendida => "attended",
        EstadoCita.Cancelada => "cancelled",
        EstadoCita.NoAsistio => "no-show",
        _ => ""
    };

    private string GetEstadoTextoDashboard(EstadoCita estado) => estado switch
    {
        EstadoCita.Programada => "Programada",
        EstadoCita.Confirmada => "Confirmada",
        EstadoCita.Atendida => "Atendida",
        EstadoCita.Cancelada => "Cancelada",
        EstadoCita.NoAsistio => "No asistió",
        _ => estado.ToString()
    };
}
