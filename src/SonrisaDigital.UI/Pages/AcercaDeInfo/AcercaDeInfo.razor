@page "/acercaDe"
@attribute [Authorize]
@using SonrisaDigital.Services.Clinicas
@inject IIdentidadClinicaService IdentidadService

<PageTitle>Acerca de · Sonrisa Digital</PageTitle>

<div class="appointments-page about-page">
    <div class="page-header">
        <div>
            <span class="page-eyebrow">Información corporativa</span>
            <h1>Información de la Empresa</h1>
            <p>Datos corporativos, institucionales y de contacto de la clínica.</p>
        </div>
        <AuthorizeView Policy="AcercaDe.Editar">
            <Authorized>
                @if (!editando && identidad is not null)
                {
                    <button type="button" class="primary-action" @onclick="EmpezarEdicion">Editar</button>
                }
            </Authorized>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="feedback @(mensajeEsError ? "error" : "success")">@mensaje</div>
    }

    @if (identidad is null)
    {
        <section class="form-panel">
            <div class="section-heading">
                <h2>Sin clínica seleccionada</h2>
                <span>Tu sesión no tiene una clínica asociada. Si eres Dueño, elige una clínica en el selector del menú.</span>
            </div>
        </section>
    }
    else if (!editando)
    {
        <section class="about-hero">
            <div class="about-hero-mark" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18"></path>
                    <path d="M5 21V7l7-4 7 4v14"></path>
                    <path d="M9 21v-4h6v4"></path>
                    <path d="M9 9h.01M15 9h.01M9 12h.01M15 12h.01"></path>
                </svg>
            </div>
            <div class="about-hero-body">
                <span class="about-eyebrow">Identidad institucional</span>
                <h2>@identidad.Nombre</h2>
                <p class="about-slogan">@(identidad.Eslogan ?? "—")</p>
                <span class="about-chip">
                    <span class="about-chip-label">RNC</span>
                    @(identidad.Rnc ?? "—")
                </span>
            </div>
        </section>

        <section class="about-section">
            <div class="about-section-heading">
                <div>
                    <h2>Contacto y ubicación</h2>
                    <p>Canales de atención al cliente y localización física.</p>
                </div>
            </div>

            <div class="about-contact-grid">
                <article class="about-contact-card">
                    <span class="about-contact-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </span>
                    <div class="about-contact-body">
                        <span class="about-contact-label">Teléfono principal</span>
                        @if (!string.IsNullOrWhiteSpace(identidad.Telefono))
                        {
                            <a class="about-contact-value" href="tel:@identidad.Telefono">@identidad.Telefono</a>
                        }
                        else
                        {
                            <strong class="about-contact-value">—</strong>
                        }
                    </div>
                </article>

                <article class="about-contact-card">
                    <span class="about-contact-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                        </svg>
                    </span>
                    <div class="about-contact-body">
                        <span class="about-contact-label">Correo electrónico</span>
                        @if (!string.IsNullOrWhiteSpace(identidad.Correo))
                        {
                            <a class="about-contact-value" href="mailto:@identidad.Correo">@identidad.Correo</a>
                        }
                        else
                        {
                            <strong class="about-contact-value">—</strong>
                        }
                    </div>
                </article>

                <article class="about-contact-card">
                    <span class="about-contact-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v5l3 2"></path>
                        </svg>
                    </span>
                    <div class="about-contact-body">
                        <span class="about-contact-label">Horario de atención</span>
                        <strong class="about-contact-value">@(identidad.Horario ?? "—")</strong>
                    </div>
                </article>

                <article class="about-contact-card about-contact-card--wide">
                    <span class="about-contact-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"></path>
                            <circle cx="12" cy="10" r="2.5"></circle>
                        </svg>
                    </span>
                    <div class="about-contact-body">
                        <span class="about-contact-label">Dirección física</span>
                        <strong class="about-contact-value">@(identidad.Direccion ?? "—")</strong>
                    </div>
                </article>
            </div>
        </section>
    }
    else
    {
        <EditForm Model="formulario" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <section class="form-panel">
                <div class="section-heading">
                    <h2>Identidad Institucional</h2>
                    <span>Estos datos se muestran a todo el personal de la clínica.</span>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label for="acerca-nombre">Nombre Comercial</label>
                        <InputText id="acerca-nombre" class="form-control" @bind-Value="formulario.Nombre" />
                        <ValidationMessage For="@(() => formulario.Nombre)" />
                    </div>
                    <div class="field">
                        <label for="acerca-rnc">RNC / Identificación Fiscal</label>
                        <InputText id="acerca-rnc" class="form-control" @bind-Value="formulario.Rnc" />
                        <ValidationMessage For="@(() => formulario.Rnc)" />
                    </div>
                    <div class="field field-wide">
                        <label for="acerca-eslogan">Eslogan corporativo</label>
                        <InputText id="acerca-eslogan" class="form-control" @bind-Value="formulario.Eslogan" />
                        <ValidationMessage For="@(() => formulario.Eslogan)" />
                    </div>
                </div>
            </section>

            <section class="form-panel">
                <div class="section-heading">
                    <h2>Contacto y Ubicación</h2>
                    <span>Canales de atención al cliente y localización física.</span>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label for="acerca-telefono">Teléfono Principal</label>
                        <InputText id="acerca-telefono" class="form-control" @bind-Value="formulario.Telefono" />
                        <ValidationMessage For="@(() => formulario.Telefono)" />
                    </div>
                    <div class="field">
                        <label for="acerca-correo">Correo Electrónico</label>
                        <InputText id="acerca-correo" class="form-control" @bind-Value="formulario.Correo" />
                        <ValidationMessage For="@(() => formulario.Correo)" />
                    </div>
                    <div class="field">
                        <label for="acerca-horario">Horario de Atención</label>
                        <InputText id="acerca-horario" class="form-control" @bind-Value="formulario.Horario" />
                        <ValidationMessage For="@(() => formulario.Horario)" />
                    </div>
                    <div class="field field-wide">
                        <label for="acerca-direccion">Dirección Física</label>
                        <InputText id="acerca-direccion" class="form-control" @bind-Value="formulario.Direccion" />
                        <ValidationMessage For="@(() => formulario.Direccion)" />
                    </div>
                </div>
            </section>

            <div class="about-edit-actions">
                <button type="submit" class="primary-action">Guardar cambios</button>
                <button type="button" class="secondary-action" @onclick="CancelarEdicion">Cancelar</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private IdentidadClinicaDto? identidad;
    private IdentidadClinicaFormDto formulario = new();
    private bool editando;
    private string? mensaje;
    private bool mensajeEsError;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        identidad = await IdentidadService.ObtenerAsync();
    }

    private void EmpezarEdicion()
    {
        formulario = new IdentidadClinicaFormDto
        {
            Nombre = identidad!.Nombre,
            Rnc = identidad.Rnc,
            Eslogan = identidad.Eslogan,
            Telefono = identidad.Telefono,
            Correo = identidad.Correo,
            Horario = identidad.Horario,
            Direccion = identidad.Direccion
        };
        editando = true;
        mensaje = null;
    }

    private void CancelarEdicion()
    {
        editando = false;
        mensaje = null;
    }

    private async Task GuardarAsync()
    {
        try
        {
            await IdentidadService.ActualizarAsync(formulario);
            editando = false;
            mensaje = "La información de la clínica se guardó correctamente.";
            mensajeEsError = false;
            await CargarAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            mensaje = ex.Message;
            mensajeEsError = true;
        }
    }
}

