@page "/login"
@layout LoginLayout

<PageTitle>Iniciar sesión · Sonrisa Digital</PageTitle>

<div class="auth-page">
    <div class="auth-card">

        <!-- Columna Izquierda: Formulario -->
        <div class="auth-form-section">

            <div class="mobile-login-brand">
                <!-- Icono de Escudo Dental en versión pequeña para móviles -->
                <div class="brand-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="M9.5 10.5c0-.8.7-1.5 1.5-1.5h2c.8 0 1.5.7 1.5 1.5v1.5c0 .8-.7 1.5-1.5 1.5h-2c-.8 0-1.5-.7-1.5-1.5v-1.5z"></path>
                    </svg>
                </div>
                <strong>Sonrisa Digital</strong>
            </div>
            <center>
            <h1 class="auth-title">Iniciar sesión</h1>
            <p class="login-subtitle">Ingrese sus credenciales para acceder al sistema.</p>
            </center>

            <form method="post" action="/account/login">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

                <div class="form-field">
                    <label for="email">Correo electrónico</label>
                    <input id="email" name="Email" type="email" value="@loginModel.Email" placeholder="correo@clinica.com" required />
                </div>

                <div class="form-field">
                    <div class="field-label-row">
                        <label for="password">Contraseña</label>
                        <a href="/login" class="forgot-link">¿Olvidó su contraseña?</a>
                    </div>
                    <input id="password" name="Password" type="password" placeholder="••••••••" required />
                </div>

                <button class="login-submit" type="submit">Ingresar</button>
            </form>

            @if (Error == "invalid")
            {
                <div class="login-error">Correo o contraseña incorrectos.</div>
            }
            else if (Error == "locked")
            {
                <div class="login-error">La cuenta está bloqueada temporalmente.</div>
            }

            <div class="login-demo"><strong>Demo:</strong> admin@sonrisadigital.com / SonrisaDigitalAdmin123</div>
        </div>

        <!-- Columna Derecha: Panel Lateral Corporativo -->
        <div class="auth-banner-section">
            <div class="banner-content">
                <div class="banner-brand-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <path d="M9.5 10.5c0-.8.7-1.5 1.5-1.5h2c.8 0 1.5.7 1.5 1.5v1.5c0 .8-.7 1.5-1.5 1.5h-2c-.8 0-1.5-.7-1.5-1.5v-1.5z"></path>
                    </svg>
                </div>
                <h2>Sonrisa Digital</h2>
                <p>Sistema integral de gestión para clínicas y profesionales odontológicos.</p>
                <span class="info-footer">Acceso exclusivo para personal autorizado</span>
            </div>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private LoginModel loginModel = new() { Email = "admin@sonrisadigital.com" };

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Introduzca un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;
    }
}