@page "/clinicas"
@attribute [Authorize(Policy = "Clinicas.Ver")]
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Data.Suscripciones
@using SonrisaDigital.Services.Clinicas
@using SonrisaDigital.Services.Clinicas.DTOs
@using SonrisaDigital.UI.Services
@inject IClinicaService ClinicaService
@inject IClinicaActivaService ClinicaActiva
@inject NavigationManager Navigation

<PageTitle>Clínicas · Sonrisa Digital</PageTitle>

<div class="clinicas-page">
    <div class="page-header">
        <div>
            <h1>Clínicas</h1>
            <p>Clínicas que usan Sonrisa Digital. Solo visible para el Dueño del sistema.</p>
        </div>
        <AuthorizeView Policy="Clinicas.Crear">
            <Authorized>
                <a class="primary-action" href="/clinicas/nueva">+ Nueva clínica</a>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="feedback error">@mensaje</div>
    }

    <section class="clinicas-panel">
        <div class="clinicas-resumen">@clinicas.Count clínica(s)</div>
        <table class="clinicas-tabla">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Estado</th>
                    <th>Plan</th>
                    <th>Vence</th>
                    <th>Acceso</th>
                    <th>Alta</th>
                    <th>Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var clinica in clinicas)
                {
                    <tr>
                        <td>@clinica.Nombre</td>
                        <td>@clinica.Codigo</td>
                        <td>
                            @clinica.Estado
                            @if (clinica.Estado == EstadoClinica.Suspendida && clinica.MotivoSuspension is not null)
                            {
                                <small class="motivo-suspension">@TextoMotivo(clinica.MotivoSuspension)</small>
                            }
                        </td>
                        <td>
                            @if (clinica.EnPrueba)
                            {
                                <span class="badge badge-prueba">Prueba</span>
                            }
                            else
                            {
                                <span>@(clinica.Plan ?? "Mensual")</span>
                            }
                        </td>
                        <td>
                            @if (clinica.FechaVencimiento is DateTime vence)
                            {
                                <span>@vence.ToString("dd/MM/yyyy")</span>
                                <small class="vence-detalle">@TextoDias(clinica)</small>
                            }
                            else
                            {
                                <span class="sin-fecha">@(clinica.EnPrueba ? "Sin iniciar" : "Sin vencimiento")</span>
                            }
                        </td>
                        <td>
                            <span class="acceso @ClaseAcceso(clinica.Acceso)">@TextoAcceso(clinica.Acceso)</span>
                        </td>
                        <td>@clinica.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="clinicas-acciones">
                            <AuthorizeView Policy="Clinicas.Editar">
                                <Authorized><a href="/clinicas/editar/@clinica.Id">Editar</a></Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Usuarios.Ver">
                                <Authorized>
                                    <button type="button" class="enlace-accion" @onclick="() => AbrirUsuariosAsync(clinica)">Usuarios</button>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Clinicas.Editar">
                                <Authorized>
                                    <a href="/clinicas/facturacion/@clinica.Id">Facturación</a>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Clinicas.Suspender">
                                <Authorized>
                                    <button type="button" class="enlace-accion" @onclick="() => CambiarEstadoAsync(clinica)">
                                        @(clinica.Estado == EstadoClinica.Activa ? "Suspender" : "Reactivar")
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

@if (clinicaPendienteSuspension is not null)
{
    <div class="modal-backdrop" @onclick="CerrarSuspension">
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="suspension-modal-title" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title" id="suspension-modal-title">Suspender clínica</h2>
                <button type="button" class="modal-close-btn" aria-label="Cerrar" @onclick="CerrarSuspension">&times;</button>
            </div>
            <div class="modal-body">
                <p>
                    Vas a suspender <strong>@clinicaPendienteSuspension.Nombre</strong>.
                    Elige el motivo para que el sistema sepa si un pago puede reactivarla.
                </p>

                <label class="motivo-opcion">
                    <input type="radio" name="motivo-suspension" value="@MotivoSuspension.FaltaDePago"
                           checked="@(motivoSuspension == MotivoSuspension.FaltaDePago)"
                           @onchange="() => motivoSuspension = MotivoSuspension.FaltaDePago" />
                    <span>
                        <strong>Falta de pago</strong>
                        <small>Un pago registrado reactivará la clínica automáticamente.</small>
                    </span>
                </label>

                <label class="motivo-opcion">
                    <input type="radio" name="motivo-suspension" value="@MotivoSuspension.DecisionAdministrativa"
                           checked="@(motivoSuspension == MotivoSuspension.DecisionAdministrativa)"
                           @onchange="() => motivoSuspension = MotivoSuspension.DecisionAdministrativa" />
                    <span>
                        <strong>Decisión administrativa</strong>
                        <small>Un pago no devuelve el acceso; la reactivación debe ser explícita.</small>
                    </span>
                </label>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="feedback error" role="alert">@mensaje</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="secondary-action" @onclick="CerrarSuspension" disabled="@guardandoEstado">Cancelar</button>
                <button type="button" class="primary-action" @onclick="SuspenderAsync" disabled="@guardandoEstado">
                    @(guardandoEstado ? "Suspendiendo..." : "Suspender clínica")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<ClinicaListItemDto> clinicas = [];
    private string? mensaje;
    private ClinicaListItemDto? clinicaPendienteSuspension;
    private MotivoSuspension motivoSuspension = MotivoSuspension.FaltaDePago;
    private bool guardandoEstado;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            clinicas = await ClinicaService.ListarAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    private async Task CambiarEstadoAsync(ClinicaListItemDto clinica)
    {
        if (clinica.Estado == EstadoClinica.Suspendida)
        {
            await ReactivarAsync(clinica);
            return;
        }

        mensaje = null;
        clinicaPendienteSuspension = clinica;
        motivoSuspension = MotivoSuspension.FaltaDePago;
    }

    private async Task SuspenderAsync()
    {
        if (clinicaPendienteSuspension is null)
        {
            return;
        }

        guardandoEstado = true;
        mensaje = null;
        try
        {
            await ClinicaService.CambiarEstadoAsync(
                clinicaPendienteSuspension.Id, EstadoClinica.Suspendida, motivoSuspension);
            clinicaPendienteSuspension = null;
            await CargarAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
        finally
        {
            guardandoEstado = false;
        }
    }

    private async Task ReactivarAsync(ClinicaListItemDto clinica)
    {
        try
        {
            await ClinicaService.CambiarEstadoAsync(clinica.Id, EstadoClinica.Activa);
            mensaje = null;
            await CargarAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    private void CerrarSuspension()
    {
        clinicaPendienteSuspension = null;
        mensaje = null;
    }

    private static string TextoMotivo(MotivoSuspension? motivo) => motivo switch
    {
        MotivoSuspension.FaltaDePago => "Falta de pago",
        MotivoSuspension.DecisionAdministrativa => "Decisión administrativa",
        _ => "Sin motivo"
    };

    /// <summary>
    /// Selecciona la clínica en esta pestaña y abre su gestión de usuarios. Así el
    /// Dueño no tiene que cambiar el selector y volver a navegar por separado.
    /// </summary>
    private async Task AbrirUsuariosAsync(ClinicaListItemDto clinica)
    {
        try
        {
            await ClinicaActiva.SeleccionarAsync(clinica.Id, clinica.Nombre, "el panel de clínicas");
            Navigation.NavigateTo("/usuarios");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    private static string TextoAcceso(AccesoClinica acceso) => acceso switch
    {
        AccesoClinica.Permitido => "Al día",
        AccesoClinica.EnGracia => "En gracia",
        AccesoClinica.Vencida => "Vencida",
        _ => "Suspendida"
    };

    private static string ClaseAcceso(AccesoClinica acceso) => acceso switch
    {
        AccesoClinica.Permitido => "ok",
        AccesoClinica.EnGracia => "gracia",
        AccesoClinica.Vencida => "vencida",
        _ => "suspendida"
    };

    private static string TextoDias(ClinicaListItemDto clinica)
    {
        if (clinica.EnPrueba && clinica.FechaVencimiento is null)
        {
            return "Empieza en el primer ingreso";
        }

        if (clinica.FechaVencimiento is null)
        {
            return "Sin vencimiento";
        }

        if (clinica.Acceso == AccesoClinica.EnGracia)
        {
            var diasGracia = ReglaSuscripcion.DiasGraciaRestantes(clinica.FechaVencimiento, ReglaSuscripcion.Hoy());
            return diasGracia == 0 ? "Último día de gracia" : $"{diasGracia} día(s) de gracia";
        }

        return clinica.DiasRestantes switch
        {
            < 0 => $"Vencida hace {Math.Abs(clinica.DiasRestantes)} día(s)",
            0 => "Vence hoy",
            _ => $"{clinica.DiasRestantes} día(s) restantes"
        };
    }
}
