@page "/clinicas"
@attribute [Authorize(Policy = "Clinicas.Ver")]
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Data.Suscripciones
@using SonrisaDigital.Services.Clinicas
@using SonrisaDigital.Services.Clinicas.DTOs
@using SonrisaDigital.UI.Services
@inject IClinicaService ClinicaService
@inject IClinicaActivaService ClinicaActiva
@inject NavigationManager Navigation

<PageTitle>Clínicas · Sonrisa Digital</PageTitle>

<div class="clinicas-page">
    <div class="page-header">
        <div>
            <h1>Clínicas</h1>
            <p>Clínicas que usan Sonrisa Digital. Solo visible para el Dueño del sistema.</p>
        </div>
        <AuthorizeView Policy="Clinicas.Crear">
            <Authorized>
                <a class="primary-action" href="/clinicas/nueva">+ Nueva clínica</a>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="feedback error">@mensaje</div>
    }

    <section class="clinicas-panel">
        <div class="clinicas-resumen">@clinicas.Count clínica(s)</div>
        <table class="clinicas-tabla">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Estado</th>
                    <th>Plan</th>
                    <th>Vence</th>
                    <th>Acceso</th>
                    <th>Alta</th>
                    <th>Opciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var clinica in clinicas)
                {
                    <tr>
                        <td>@clinica.Nombre</td>
                        <td>@clinica.Codigo</td>
                        <td>@clinica.Estado</td>
                        <td>
                            @if (clinica.EnPrueba)
                            {
                                <span class="badge badge-prueba">Prueba</span>
                            }
                            else
                            {
                                <span>@(clinica.Plan ?? "Mensual")</span>
                            }
                        </td>
                        <td>
                            @if (clinica.FechaVencimiento is DateTime vence)
                            {
                                <span>@vence.ToString("dd/MM/yyyy")</span>
                                <small class="vence-detalle">@TextoDias(clinica)</small>
                            }
                            else
                            {
                                <span class="sin-fecha">Sin iniciar</span>
                            }
                        </td>
                        <td>
                            <span class="acceso @ClaseAcceso(clinica.Acceso)">@TextoAcceso(clinica.Acceso)</span>
                        </td>
                        <td>@clinica.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="clinicas-acciones">
                            <AuthorizeView Policy="Clinicas.Editar">
                                <Authorized><a href="/clinicas/editar/@clinica.Id">Editar</a></Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Usuarios.Ver">
                                <Authorized>
                                    <button type="button" class="enlace-accion" @onclick="() => AbrirUsuariosAsync(clinica)">Usuarios</button>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Clinicas.Editar">
                                <Authorized>
                                    <a href="/clinicas/facturacion/@clinica.Id">Facturación</a>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Policy="Clinicas.Suspender">
                                <Authorized>
                                    <button type="button" class="enlace-accion" @onclick="() => CambiarEstadoAsync(clinica)">
                                        @(clinica.Estado == EstadoClinica.Activa ? "Suspender" : "Reactivar")
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

@code {
    private IReadOnlyList<ClinicaListItemDto> clinicas = [];
    private string? mensaje;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            clinicas = await ClinicaService.ListarAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    private async Task CambiarEstadoAsync(ClinicaListItemDto clinica)
    {
        var nuevo = clinica.Estado == EstadoClinica.Activa ? EstadoClinica.Suspendida : EstadoClinica.Activa;
        try
        {
            await ClinicaService.CambiarEstadoAsync(clinica.Id, nuevo);
            mensaje = null;
            await CargarAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    /// <summary>
    /// Selecciona la clínica en esta pestaña y abre su gestión de usuarios. Así el
    /// Dueño no tiene que cambiar el selector y volver a navegar por separado.
    /// </summary>
    private async Task AbrirUsuariosAsync(ClinicaListItemDto clinica)
    {
        try
        {
            await ClinicaActiva.SeleccionarAsync(clinica.Id, clinica.Nombre, "el panel de clínicas");
            Navigation.NavigateTo("/usuarios");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            mensaje = ex.Message;
        }
    }

    private static string TextoAcceso(AccesoClinica acceso) => acceso switch
    {
        AccesoClinica.Permitido => "Al día",
        AccesoClinica.EnGracia => "En gracia",
        AccesoClinica.Vencida => "Vencida",
        _ => "Suspendida"
    };

    private static string ClaseAcceso(AccesoClinica acceso) => acceso switch
    {
        AccesoClinica.Permitido => "ok",
        AccesoClinica.EnGracia => "gracia",
        AccesoClinica.Vencida => "vencida",
        _ => "suspendida"
    };

    private static string TextoDias(ClinicaListItemDto clinica)
    {
        if (clinica.EnPrueba && clinica.FechaVencimiento is null)
        {
            return "Empieza en el primer ingreso";
        }

        return clinica.DiasRestantes switch
        {
            < 0 => $"Vencida hace {Math.Abs(clinica.DiasRestantes)} día(s)",
            0 => "Vence hoy",
            _ => $"{clinica.DiasRestantes} día(s) restantes"
        };
    }
}
