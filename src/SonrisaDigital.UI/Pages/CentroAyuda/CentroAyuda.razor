@page "/centro-ayuda"

<PageTitle>Centro de Ayuda</PageTitle>

<div class="help-page">

    <!-- Encabezado -->
    <div class="page-header">
        <div>
            <h1>Centro de Ayuda</h1>
            <p>
                Encuentra información, guías y soluciones para utilizar
                correctamente el sistema Sonrisa Digital.
            </p>
        </div>
    </div>


    <!-- Tarjetas de ayuda -->
    <div class="help-grid">

        <!-- Preguntas frecuentes -->
        <div class="help-card">
            <div class="help-card-content">
                <h2>Preguntas frecuentes❓</h2>

                <p>
                    Consulta las respuestas sobre pacientes, odontólogos, citas,
                    historia clínica, odontograma, tratamientos, pagos, usuarios,
                    permisos, auditoría y reportes.
                </p>

                <a href="/centro-ayuda/preguntas-frecuentes"
                   class="help-card-link">
                    Ver preguntas
                    <span>→</span>
                </a>
            </div>

        </div>


        <!-- Guías rápidas -->
        <div class="help-card">

            <div class="help-card-content">

                <h2>Guías rápidas📖</h2>

                <p>
                    Aprende paso a paso cómo registrar pacientes, odontólogos,
                    citas, tratamientos, pagos, consultas clínicas y usuarios.
                </p>

                <a href="/centro-ayuda/guias"
                   class="help-card-link">
                    Ver guías
                    <span>→</span>
                </a>

            </div>

        </div>


        <!-- Solución de problemas -->
        <div class="help-card">
            <div class="help-card-content">

                <h2>Solución de problemas🔧</h2>

                <p>
                    Encuentra soluciones para los problemas más comunes con
                    pacientes, citas, permisos, inicio de sesión, tratamientos,
                    pagos, historia clínica y odontograma.
                </p>

                <a href="/centro-ayuda/problemas"
                   class="help-card-link">
                    Ver soluciones
                    <span>→</span>
                </a>

            </div>
        </div>


        <!-- Contactar soporte -->
        <div class="help-card">

            <div class="help-card-content">

                <h2>Contactar soporte📞</h2>

                <p>
                    Si no encuentras la solución que necesitas,
                    comunícate con el administrador del sistema
                    o utiliza los canales de contacto de la clínica.
                </p>

                <a href="/centro-ayuda/soporte"
                   class="help-card-link">
                    Contactar soporte
                    <span>→</span>
                </a>

            </div>

        </div>

    </div>


    <!-- Módulos del sistema -->
    <section class="help-section">

        <div class="help-section-header">
            <div>
                <h2>Módulos del sistema</h2>
                <p>
                    Estos son los módulos disponibles en Sonrisa Digital. La
                    visibilidad de cada uno depende de los permisos de tu rol.
                </p>
            </div>
        </div>

        <div class="faq-list">

            <div class="faq-item">
                <h3>Dashboard (Inicio)</h3>
                <p>
                    Muestra indicadores de pacientes y odontólogos activos,
                    citas del día, actividad reciente y saldo pendiente.
                </p>
            </div>

            <div class="faq-item">
                <h3>Pacientes</h3>
                <p>
                    Registro, búsqueda, edición, ficha del paciente y
                    activación/desactivación. Incluye tipo de sangre y alergias.
                </p>
            </div>

            <div class="faq-item">
                <h3>Odontólogos</h3>
                <p>
                    Administración de los profesionales: licencia, especialidad,
                    teléfono, correo y estado.
                </p>
            </div>

            <div class="faq-item">
                <h3>Citas</h3>
                <p>
                    Programación, edición, cancelación y atención de citas.
                    Al marcar una cita como Atendida se crea su consulta clínica.
                </p>
            </div>

            <div class="faq-item">
                <h3>Historia clínica</h3>
                <p>
                    Antecedentes médicos y odontológicos, y consultas clínicas
                    con diagnóstico y plan de tratamiento.
                </p>
            </div>

            <div class="faq-item">
                <h3>Odontograma</h3>
                <p>
                    Estado de las 32 piezas dentales con numeración FDI,
                    observaciones y registro de última modificación.
                </p>
            </div>

            <div class="faq-item">
                <h3>Tratamientos</h3>
                <p>
                    Catálogo de servicios y registro de tratamientos realizados
                    a los pacientes, con pieza dental, precio y estado.
                </p>
            </div>

            <div class="faq-item">
                <h3>Pagos</h3>
                <p>
                    Registro de pagos por tratamiento, control de saldos y
                    historial de pagos. No permite pagar más que el saldo.
                </p>
            </div>

            <div class="faq-item">
                <h3>Usuarios</h3>
                <p>
                    Administración de cuentas, roles, estado de acceso y
                    vinculación con el registro de odontólogo.
                </p>
            </div>

            <div class="faq-item">
                <h3>Roles y permisos</h3>
                <p>
                    Asignación granular de los 32 permisos del sistema a cada rol.
                </p>
            </div>

            <div class="faq-item">
                <h3>Auditoría</h3>
                <p>
                    Consulta de las operaciones relevantes realizadas en el
                    sistema. Los registros no se modifican desde la interfaz.
                </p>
            </div>

            <div class="faq-item">
                <h3>Reportes</h3>
                <p>
                    Reportes de citas, pacientes atendidos, tratamientos y pagos,
                    con períodos, filtros y exportación a PDF.
                </p>
            </div>

        </div>

    </section>

</div>


