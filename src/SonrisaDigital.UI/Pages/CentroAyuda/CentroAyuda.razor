@page "/centro-ayuda"

<PageTitle>Centro de Ayuda</PageTitle>

<div class="help-page">

    <!-- Encabezado -->
    <div class="page-header">
        <div>
            <h1>Centro de Ayuda</h1>
            <p>
                Encuentra información, guías y soluciones para utilizar
                correctamente el sistema Sonrisa Digital.
            </p>
        </div>
    </div>


    <!-- Tarjetas de ayuda -->
    <div class="help-grid">

        <!-- Preguntas frecuentes -->
        <div class="help-card">
            <div class="help-card-content">
                <h2>Preguntas frecuentes❓</h2>

                <p>
                    Consulta las preguntas más comunes sobre pacientes,
                    odontólogos, citas, tratamientos, pagos y otros
                    módulos de Sonrisa Digital.
                </p>

                <a href="/centro-ayuda/preguntas-frecuentes"
                   class="help-card-link">
                    Ver preguntas
                    <span>→</span>
                </a>
            </div>

        </div>


        <!-- Guías rápidas -->
        <div class="help-card">

            <div class="help-card-content">

                <h2>Guías rápidas📖</h2>

                <p>
                    Aprende paso a paso cómo realizar las principales
                    operaciones dentro del sistema.
                </p>

                <a href="/centro-ayuda/guias"
                   class="help-card-link">
                    Ver guías
                    <span>→</span>
                </a>

            </div>

        </div>


        <!-- Solución de problemas -->
        <div class="help-card">
            <div class="help-card-content">

                <h2>Solución de problemas🔧</h2>

                <p>
                    Encuentra soluciones para los problemas más comunes
                    que pueden presentarse durante el uso de Sonrisa Digital.
                </p>

                <a href="/centro-ayuda/problemas"
                   class="help-card-link">
                    Ver soluciones
                    <span>→</span>
                </a>

            </div>

        </div>


        <!-- Contactar soporte -->
        <div class="help-card">

            <div class="help-card-content">

                <h2>Contactar soporte📞</h2>

                <p>
                    Si no encuentras la solución que necesitas,
                    comunícate con el administrador del sistema.
                </p>

                <a href="/centro-ayuda/soporte"
                   class="help-card-link">
                    Contactar soporte
                    <span>→</span>
                </a>

            </div>

        </div>

    </div>

</div>


@code {

}
