@page "/centro-ayuda"

<PageTitle>Centro de Ayudas</PageTitle>

<div class="help-page">

    <!-- Encabezado -->
    <div class="page-header">
        <div>
            <span class="page-eyebrow">Soporte y documentación</span>
            <h1>Centro de Ayudas</h1>
            <p>
                Encuentra información, guías y soluciones para utilizar
                correctamente el sistema Sonrisa Digital.
            </p>
        </div>
    </div>

    <!-- Accesos de ayuda -->
    <div class="help-grid">

        <!-- Preguntas frecuentes -->
        <a class="help-card help-card--faq" href="/centro-ayuda/preguntas-frecuentes">
            <span class="help-card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.2-3 4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
            </span>
            <div class="help-card-content">
                <h2>Preguntas frecuentes</h2>
                <p>
                    Consulta las respuestas sobre pacientes, odontólogos, citas,
                    historia clínica, odontograma, tratamientos, pagos, usuarios,
                    permisos, auditoría y reportes.
                </p>
                <span class="help-card-link">
                    Ver preguntas
                    <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>

        <!-- Guías rápidas -->
        <a class="help-card help-card--guides" href="/centro-ayuda/guias">
            <span class="help-card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
            </span>
            <div class="help-card-content">
                <h2>Guías rápidas</h2>
                <p>
                    Aprende paso a paso cómo registrar pacientes, citas,
                    tratamientos, pagos, consultas clínicas y usuarios.
                </p>
                <span class="help-card-link">
                    Ver guías
                    <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>

        <!-- Solución de problemas -->
        <a class="help-card help-card--trouble" href="/centro-ayuda/problemas">
            <span class="help-card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2.4-.5-.5-2.4 2.2-2.4z"></path>
                </svg>
            </span>
            <div class="help-card-content">
                <h2>Solución de problemas</h2>
                <p>
                    Encuentra soluciones para los problemas más comunes con
                    pacientes, citas, permisos, inicio de sesión, tratamientos,
                    pagos, historia clínica y odontograma.
                </p>
                <span class="help-card-link">
                    Ver soluciones
                    <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>

        <!-- Información de los módulos del sistema -->
        <a class="help-card help-card--modules" href="/centro-ayuda/modulos-del-sistema">
            <span class="help-card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
            </span>
            <div class="help-card-content">
                <h2>Módulos del sistema</h2>
                <p>
                    Encuentra información y guías sobre los
                    módulos disponibles en Sonrisa Digital.
                </p>
                <span class="help-card-link">
                    Ver información
                    <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>

        <!-- Contactar soporte -->
        <a class="help-card help-card--support" href="/centro-ayuda/soporte">
            <span class="help-card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 14v-2a8 8 0 0 1 16 0v2"></path>
                    <rect x="2" y="14" width="4" height="6" rx="2"></rect>
                    <rect x="18" y="14" width="4" height="6" rx="2"></rect>
                    <path d="M22 18a4 4 0 0 1-4 4h-3"></path>
                </svg>
            </span>
            <div class="help-card-content">
                <h2>Contactar soporte</h2>
                <p>
                    Si no encuentras la solución que necesitas, comunícate con
                    el administrador del sistema o utiliza los canales de
                    contacto de la clínica.
                </p>
                <span class="help-card-link">
                    Contactar soporte
                    <span aria-hidden="true">→</span>
                </span>
            </div>
        </a>

    </div>

</div>

@code {

}
