@page "/centro-ayuda/guias"

<PageTitle>Guías Rápidas</PageTitle>

<div class="page-header">
    <div>
        <h1>Guías rápidas</h1>
        <p>Aprende a utilizar las principales funciones de Sonrisa Digital.</p>
    </div>
</div>


<section class="form-panel">

    <div class="section-heading">
        <h2>Registrar un paciente</h2>
    </div>

    <ol>
        <li>Entrar al módulo <strong>Pacientes</strong>.</li>
        <li>Seleccionar <strong>Nuevo paciente</strong>.</li>
        <li>Completar los datos personales.</li>
        <li>Completar la información de contacto.</li>
        <li>Registrar el contacto de emergencia.</li>
        <li>Revisar los datos.</li>
        <li>Presionar <strong>Guardar paciente</strong>.</li>
    </ol>

</section>


<section class="form-panel">

    <div class="section-heading">
        <h2>Registrar un odontólogo</h2>
    </div>

    <ol>
        <li>Entrar a <strong>Odontólogos</strong>.</li>
        <li>Seleccionar <strong>Nuevo odontólogo</strong>.</li>
        <li>Introducir nombres y apellidos.</li>
        <li>Introducir el número de licencia.</li>
        <li>Seleccionar la especialidad.</li>
        <li>Introducir teléfono y correo.</li>
        <li>Presionar <strong>Guardar odontólogo</strong>.</li>
    </ol>

</section>


<section class="form-panel">

    <div class="section-heading">
        <h2>Crear una cita</h2>
    </div>

    <ol>
        <li>Entrar al módulo <strong>Citas</strong>.</li>
        <li>Seleccionar <strong>Nueva cita</strong>.</li>
        <li>Seleccionar el paciente.</li>
        <li>Seleccionar el odontólogo.</li>
        <li>Seleccionar la fecha.</li>
        <li>Seleccionar la hora.</li>
        <li>Completar la información requerida.</li>
        <li>Guardar la cita.</li>
    </ol>

</section>


<section class="form-panel">

    <div class="section-heading">
        <h2>Registrar un tratamiento</h2>
    </div>

    <ol>
        <li>Buscar al paciente.</li>
        <li>Acceder a su información clínica.</li>
        <li>Seleccionar <strong>Tratamientos</strong>.</li>
        <li>Crear el tratamiento.</li>
        <li>Introducir el diagnóstico.</li>
        <li>Introducir el procedimiento.</li>
        <li>Registrar las observaciones.</li>
        <li>Guardar.</li>
    </ol>

</section>


<section class="form-panel">

    <div class="section-heading">
        <h2>Registrar un pago</h2>
    </div>

    <ol>
        <li>Entrar al módulo <strong>Pagos</strong>.</li>
        <li>Seleccionar el paciente.</li>
        <li>Seleccionar la cita o tratamiento relacionado.</li>
        <li>Introducir el monto.</li>
        <li>Seleccionar el método de pago.</li>
        <li>Confirmar el registro.</li>
    </ol>

</section>


<div class="form-actions">
    <a class="cancel-action" href="/centro-ayuda">
        Volver al Centro de Ayuda
    </a>
</div>
@code {

}
