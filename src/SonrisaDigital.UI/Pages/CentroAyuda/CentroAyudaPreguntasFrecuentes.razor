@page "/centro-ayuda/preguntas-frecuentes"

<PageTitle>Preguntas Frecuentes</PageTitle>

<div class="help-page">

    <div class="page-header">
        <div>
            <h1>Preguntas frecuentes</h1>
            <p>
                Respuestas a las preguntas más comunes sobre
                el funcionamiento del Sistemaa Dental.
            </p>
        </div>
    </div>


    <!-- PACIENTES -->
    <section class="help-section">

        <div class="help-section-header">

            <div>
                <h2>Pacientes👤</h2>
                <p>Administración y registro de pacientes.</p>
            </div>
        </div>


        <div class="faq-list">

            <div class="faq-item">
                <h3>¿Cómo registro un nuevo paciente?</h3>

                <p>
                    Dirígete al módulo <strong>Pacientes</strong>,
                    selecciona <strong>Nuevo paciente</strong>,
                    completa los datos requeridos y presiona
                    <strong>Guardar paciente</strong>.
                </p>
            </div>


            <div class="faq-item">
                <h3>¿Cómo edito los datos de un paciente?</h3>

                <p>
                    Entra al módulo <strong>Pacientes</strong>,
                    busca al paciente y selecciona la opción
                    <strong>Editar</strong>.
                </p>
            </div>


            <div class="faq-item">
                <h3>¿Puedo desactivar un paciente?</h3>

                <p>
                    Sí. Al editar el paciente puedes cambiar su
                    estado a <strong>Inactivo</strong>. La información
                    se conserva en el sistema.
                </p>
            </div>

        </div>

    </section>


    <!-- ODONTÓLOGOS -->
    <section class="help-section">

        <div class="help-section-header">

            <div>
                <h2>Odontólogos🦷</h2>
                <p>Administración de los profesionales.</p>
            </div>

        </div>


        <div class="faq-list">

            <div class="faq-item">

                <h3>¿Cómo registro un odontólogo?</h3>

                <p>
                    Ve a <strong>Odontólogos → Nuevo odontólogo</strong>,
                    completa sus datos, selecciona su especialidad
                    y presiona <strong>Guardar odontólogo</strong>.
                </p>

            </div>


            <div class="faq-item">

                <h3>¿Puedo desactivar un odontólogo?</h3>

                <p>
                    Sí. Al editar el odontólogo puedes cambiar su
                    estado a <strong>Inactivo</strong>.
                </p>

            </div>

        </div>

    </section>


    <!-- CITAS -->
    <section class="help-section">

        <div class="help-section-header">

            <div>
                <h2>Citas📅</h2>
                <p>Gestión de las citas odontológicas.</p>
            </div>

        </div>


        <div class="faq-list">

            <div class="faq-item">

                <h3>¿Cómo creo una cita?</h3>

                <p>
                    Ve a <strong>Citas → Nueva cita</strong>,
                    selecciona el paciente, odontólogo, fecha
                    y hora, completa la información requerida
                    y guarda la cita.
                </p>

            </div>


            <div class="faq-item">

                <h3>¿Puedo modificar una cita?</h3>

                <p>
                    Sí. Busca la cita que deseas modificar y
                    selecciona la opción <strong>Editar</strong>.
                </p>

            </div>

        </div>

    </section>


    <!-- TRATAMIENTOS -->
    <section class="help-section">

        <div class="help-section-header">

            <div>
                <h2>Tratamientos💊</h2>
                <p>Información relacionada con los tratamientos.</p>
            </div>

        </div>


        <div class="faq-list">

            <div class="faq-item">

                <h3>¿Cómo registro un tratamiento?</h3>

                <p>
                    Accede al módulo <strong>Tratamientos</strong>,
                    selecciona la opción para crear un nuevo tratamiento,
                    completa la información y guarda el registro.
                </p>

            </div>

        </div>

    </section>


    <!-- PAGOS -->
    <section class="help-section">

        <div class="help-section-header">

            <div>
                <h2>Pagos💰</h2>
                <p>Registro y consulta de pagos.</p>
            </div>

        </div>


        <div class="faq-list">

            <div class="faq-item">

                <h3>¿Cómo registro un pago?</h3>

                <p>
                    Entra al módulo <strong>Pagos</strong>,
                    selecciona el paciente o la cita correspondiente,
                    introduce el monto, selecciona el método de pago
                    y registra la operación.
                </p>

            </div>

        </div>

    </section>


    <!-- BOTÓN VOLVER -->
    <div class="help-back">

        <a href="/centro-ayuda"
           class="cancel-action">

            ← Volver al Centro de Ayuda

        </a>

    </div>

</div>

