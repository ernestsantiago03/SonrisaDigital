@page "/odontologo"
@attribute [Authorize(Policy = "Odontologos.Ver")]
@attribute [Authorize]
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Services.Odontologos
@using SonrisaDigital.Services.Odontologos.DTOs
@inject IOdontologoService OdontologoService

<PageTitle>Odontólogos · Sonrisa Digital</PageTitle>

<div class="patients-page">
    <div class="page-header">
        <div>
            <h1>Odontólogos 🦷</h1>
            <p>Administra la información de los odontólogos de la clínica.</p>
        </div>
        <AuthorizeView Policy="Odontologos.Crear">
            <Authorized><a class="primary-action" href="/odontologo/nuevo">+ Registrar odontólogo</a></Authorized>
        </AuthorizeView>
    </div>

    <section class="filter-panel" aria-label="Filtros de odontólogos">
        <div class="search-field">
            <label for="dentist-search">Buscar</label>
            <input id="dentist-search" @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" placeholder="Nombre, licencia, especialidad o teléfono" />
        </div>
        <button class="secondary-action" @onclick="BuscarOdontologosAsync">Buscar</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="feedback error" role="alert">@errorMessage</div>
    }

    <section class="table-panel">
        <div class="table-summary">@odontologos.Total odontólogo(s) encontrado(s)</div>
        @if (loading)
        {
            <div class="table-state">Cargando odontólogos...</div>
        }
        else if (odontologos.Items.Count == 0)
        {
            <div class="table-state empty-state">
                <strong>No hay odontólogos para mostrar</strong>
                <span>Prueba con otros filtros o registra el primer odontólogo.</span>
            </div>
        }
        else
        {
            <div class="activity-scroll" style="max-height: 600px; overflow-y: auto;">
                <table class="patients-table">
                    <thead>
                        <tr>
                            <th>Nombre completo</th>
                            <th>Licencia</th>
                            <th>Especialidad</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Opciones</th>
                            <th><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var odontologo in odontologos.Items)
                        {
                            <tr>
                                <td><a class="patient-name" href="/odontologo/@odontologo.Id">@odontologo.NombreCompleto</a></td>
                                <td>@(odontologo.NumeroLicencia ?? "-")</td>
                                <td>@(odontologo.Especialidad ?? "-")</td>
                                <td>@(odontologo.Telefono ?? "-")</td>
                                <td>@(odontologo.Correo ?? "-")</td>
                                <td class="row-actions">
                                    <a href="/odontologo/@odontologo.Id">Ver</a>
                                    <AuthorizeView Policy="Odontologos.Editar">
                                        <Authorized><a href="/odontologo/editar/@odontologo.Id">Editar</a></Authorized>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!loading && odontologos.Total > 0)
        {
            <PaginationFooter Page="odontologos.Page"
                              TotalPages="odontologos.TotalPages"
                              Total="odontologos.Total"
                              ItemLabel="odontólogo(s) encontrado(s)"
                              OnPageChange="IrAPaginaOdontologosAsync" />
        }
    </section>
</div>

@code {
    private const int PageSize = 10;
    private PagedResult<OdontologoListItemDto> odontologos = PagedResult<OdontologoListItemDto>.Empty(PageSize);
    private string searchTerm = string.Empty;
    private string statusFilter = "Todos";
    private bool loading;
    private string? errorMessage;
    private readonly SemaphoreSlim cargaLock = new(1, 1);

    protected override Task OnInitializedAsync() => LoadOdontologosAsync();

    private async Task LoadOdontologosAsync()
    {
        // El DbContext es compartido: se atienden las cargas una por una para que
        // dos clics rápidos no ejecuten consultas al mismo tiempo.
        await cargaLock.WaitAsync();
        loading = true;
        errorMessage = null;
        try
        {
            var status = statusFilter switch
            {
                "Activo" => EstadoRegistro.Activo,
                _ => EstadoRegistro.Activo
            };

            // El servicio cuenta en SQL y devuelve solo la página solicitada.
            odontologos = await OdontologoService.SearchPagedAsync(searchTerm, status, odontologos.Page, PageSize);
        }
        catch (Exception)
        {
            errorMessage = "No fue posible cargar los odontólogos.";
        }
        finally
        {
            loading = false;
            cargaLock.Release();
        }
    }

    // Al aplicar un filtro se vuelve a la primera página.
    private async Task BuscarOdontologosAsync()
    {
        odontologos = odontologos with { Page = 1 };
        await LoadOdontologosAsync();
    }

    private async Task IrAPaginaOdontologosAsync(int page)
    {
        if (page < 1 || page > odontologos.TotalPages)
        {
            return;
        }

        odontologos = odontologos with { Page = page };
        await LoadOdontologosAsync();
    }

    private Task HandleSearchKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" ? BuscarOdontologosAsync() : Task.CompletedTask;
}
