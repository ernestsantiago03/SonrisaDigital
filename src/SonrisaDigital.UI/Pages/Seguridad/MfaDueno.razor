@page "/seguridad/mfa"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using SonrisaDigital.Data.Entities
@using SonrisaDigital.Services.Autorizacion
@inject UserManager<Usuario> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Segundo factor · Sonrisa Digital</PageTitle>

<div class="mfa-page">
    <header>
        <span class="page-eyebrow">Seguridad de la cuenta</span>
        <h1>Segundo factor</h1>
    </header>

    @if (noDisponible)
    {
        <div class="feedback error" role="alert">Esta configuración solo está disponible para el rol Dueño.</div>
    }
    else if (activo)
    {
        <div class="feedback success" role="status">El segundo factor está activo en tu cuenta.</div>
    }
    else
    {
        <section class="mfa-container">
            <div class="mfa-card">
                <h2 class="mfa-title">Verificación en dos pasos</h2>
                <p class="mfa-instructions">Escribe el código de 6 dígitos de tu app autenticadora.</p>

                <div class="mfa-clave">
                    <p>Si tu app no puede escanear un código, elige «Ingresar clave manualmente» y escribe esta clave:</p>
                    <code id="mfa-clave" class="mfa-clave-valor">@claveFormateada</code>
                    <p class="mfa-clave-detalle">Cuenta: @correo · Tipo: basada en tiempo (TOTP) · 6 dígitos</p>
                </div>

                <form method="post" action="/seguridad/mfa/activar" class="mfa-form">
                    <AntiforgeryToken />
            
                    <!-- Campo 1 -->
                    <div class="mfa-field">
                        <label for="mfa-codigo">Código de la app</label>
                        <input id="mfa-codigo" name="Codigo" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" required />
                    </div>

                    <!-- Campo 2 -->
                    <div class="mfa-field">
                        <label for="mfa-recuperacion">o código de recuperación</label>
                        <input id="mfa-recuperacion" name="CodigoRecuperacion" type="text" placeholder="Solo si perdiste el acceso" />
                    </div>

                    <!-- Contenedor para alinear el botón con los inputs -->
                    <div class="mfa-action-row">
                        <button type="submit" class="mfa-btn">Verificar</button>
                    </div>
                </form>

                @if (Error == "invalid" || Error == "expired")
                {
                    <div class="mfa-alert error" role="alert">
                        @(Error == "invalid" ? "El código no es correcto." : "La página expiró.")
                    </div>
                }
            </div>
        </section>


    }
</div>

@code {
    private bool noDisponible;
    private bool activo;
    private string claveRaw = string.Empty;
    private string correo = string.Empty;

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usuario = await UserManager.GetUserAsync(estado.User);

        if (usuario is null || !estado.User.IsInRole(RolesSonrisaDigital.Dueno))
        {
            noDisponible = true;
            return;
        }

        // La clave la crea el login. Esta pantalla solo la lee.
        activo = usuario.TwoFactorEnabled;
        if (!activo)
        {
            claveRaw = await UserManager.GetAuthenticatorKeyAsync(usuario) ?? string.Empty;
            correo = usuario.Email ?? usuario.UserName ?? string.Empty;
        }
    }

    // Agrupa la clave en bloques de 4 para que sea legible al copiarla a mano.
    private string claveFormateada =>
        string.Join(" ", Enumerable.Range(0, (claveRaw.Length + 3) / 4)
            .Select(i => claveRaw.Substring(i * 4, Math.Min(4, claveRaw.Length - i * 4))));
}
