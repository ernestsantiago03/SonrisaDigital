{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "REEMPLAZAR_CON_DOMINIO_REAL",

  // IPs de los proxies que pueden enviar X-Forwarded-*.
  // Si la app corre en IIS local, dejar la lista vacía (loopback).
  // Si corre detrás de nginx/balanceador, agregar su IP aquí.
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": []
  }
}