{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SonrisaDigital": "Error"
    }
  },
  "AllowedHosts": "REEMPLAZAR_CON_DOMINIO_REAL",

  // Ruta absoluta y persistente para las claves de Data Protection.
  // Ejemplo: "C:\\Sites\\SonrisaDigital\\data-protection-keys".
  // No usar una carpeta dentro de la publicación porque se reemplaza al actualizar.
  "DataProtection": {
    "KeysPath": ""
  },

  // IPs de los proxies que pueden enviar X-Forwarded-*.
  // Si la app corre en IIS local, dejar la lista vacía (loopback).
  // Si corre detrás de nginx/balanceador, agregar su IP aquí.
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": []
  }
}