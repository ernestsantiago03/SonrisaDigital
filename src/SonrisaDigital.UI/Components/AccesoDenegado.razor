@page "/acceso-denegado"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Sin permisos · Sonrisa Digital</PageTitle>

@if (esAnonimo)
{
    <RedirectToLogin />
}
else
{
    <div class="denied-page">
        <span class="denied-badge">Acceso restringido</span>
        <h1>No tienes permisos para esta sección</h1>
        <p>
            Tu cuenta no tiene habilitado el permiso necesario para entrar aquí.
            Si necesitas acceso, pídele al administrador que lo revise en <strong>Roles y permisos</strong>.
        </p>
        <a class="denied-action" href="/">Volver al inicio</a>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool esAnonimo;

    protected override void OnInitialized()
    {
        // En SSR estático la cookie se refleja en HttpContext.User; el
        // AuthenticationStateProvider del circuito no está disponible aquí.
        esAnonimo = HttpContext.User.Identity?.IsAuthenticated != true;
    }
}
