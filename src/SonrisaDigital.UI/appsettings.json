{
  "ConnectionStrings": {
    // En producción se configura por variable de entorno o user-secrets.
    // No versionar cadenas de conexión reales.
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SonrisaDigital": "Information"
    }
  },
  // En producción sobrescribir por variable de entorno AllowedHosts o appsettings.Production.json.
  "AllowedHosts": "localhost",

  // Proxies de confianza para X-Forwarded-For / X-Forwarded-Proto.
  // ForwardLimit = 1 confía en el último proxy de la cadena.
  // KnownProxies: agregar las IPs de nginx/balanceador. Vacío = loopback (IIS local).
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": []
  }
}
