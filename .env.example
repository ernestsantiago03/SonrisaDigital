# Plantilla de configuración para docker compose.
#
# 1. Copiar este archivo a `.env` (el `.env` está ignorado por Git).
# 2. Completar CONNECTION_STRING, DUENO_EMAIL y DUENO_PASSWORD.
# 3. Ajustar WINDOWS_TAG al host donde se ejecutan los contenedores.
#
# No subir `.env` al repositorio.

# Windows Server 2022 -> ltsc2022
# Windows Server 2025 o Windows 11 24H2+ -> ltsc2025
# La imagen del contenedor debe coincidir con la versión de Windows del host.
WINDOWS_TAG=ltsc2022
DOTNET_VERSION=10.0

# Número de réplicas de la aplicación detrás de nginx.
APP_REPLICAS=2

# Etiqueta de las imágenes construidas localmente.
SD_TAG=local

# Puerto del host donde escucha nginx. La aplicación no publica puertos.
HTTP_PORT=8080

# Carpeta del host para las claves de Data Protection y las imágenes clínicas.
# Debe estar respaldada. Docker crea las subcarpetas si no existen.
# Usar barras inclinadas (/) también en Windows para evitar problemas de escape.
SD_DATA_DIR=C:/SonrisaDigital/datos

# Hosts que la aplicación acepta (cabecera Host). No usar "*".
# Para pruebas locales alcanza con localhost; en producción agregar el dominio
# real separado por punto y coma, por ejemplo:
#   ALLOWED_HOSTS=localhost;clinica.ejemplo.com
ALLOWED_HOSTS=localhost

# Cadena de conexión a SQL Server. El servidor debe ser accesible desde los
# contenedores. En Docker Desktop para Windows, host.docker.internal puede no
# resolver en contenedores Windows: usar la IP del host o el nombre de un
# contenedor de SQL Server en la misma red.
# Si el certificado de SQL Server no es de confianza en el entorno de prueba,
# agregar TrustServerCertificate=True (en producción se recomienda False).
CONNECTION_STRING='Server=192.168.1.10,1433;Database=SonrisaDigital;User Id=sonrisa_app;Password=CAMBIA_ESTA_CLAVE;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True'

# Cuenta global del Dueño. La contraseña debe cumplir la política del sistema
# (mínimo 16 caracteres) y no debe quedar en el repositorio.
DUENO_EMAIL=duenio@midominio.com
DUENO_PASSWORD=
